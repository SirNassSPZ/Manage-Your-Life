<UserControl
    x:Class="DeuxiemeCerveau.Windows.Vues.VueProjets"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DeuxiemeCerveau.Windows.Convertisseurs"
    xmlns:vm="using:DeuxiemeCerveau.Presentation.VueModeles">

    <UserControl.Resources>
        <conv:BoolVersVisibilite x:Key="SiVrai" />
        <conv:BoolVersVisibiliteInverse x:Key="SiFaux" />
        <conv:TexteVersVisibilite x:Key="SiTexte" />
        <conv:HexPinceau x:Key="Hex" />
        <conv:ObjetVersVisibilite x:Key="SiObjet" />
        <conv:ObjetAbsentVersVisibilite x:Key="SiPasObjet" />
        <conv:CouleurType x:Key="CouleurType" />
        <conv:FondType x:Key="FondType" />
        <conv:EncreJour x:Key="EncreJour" />
    </UserControl.Resources>

    <Grid x:Name="RacineProjets" Background="{StaticResource Surface}" Padding="22,20,22,22"
          ColumnSpacing="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Colonne des projets ============ -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Projets" Style="{StaticResource TitreVue}" />

            <!-- Création : un champ, une touche Entrée. Un objectif de vie se note quand il
                 arrive, pas au bout d'un formulaire. -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{x:Bind Modele.NouveauNom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Commencer le MMA…" FontSize="13.5"
                         AutomationProperties.Name="Nom du nouveau projet"
                         KeyDown="SurToucheNouveauProjet" />
                <Button Grid.Column="1" Style="{StaticResource BoutonPrimaire}" Content="Créer"
                        Padding="13,8" FontSize="12.5"
                        Command="{x:Bind Modele.CreerCommand}" />
            </Grid>

            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="6">
                    <!-- Rattrapage : des calendriers de projets déjà supprimés traînaient dans les
                         filtres. Ils ont été rangés à la corbeille au démarrage (§5.3, D-030) — une
                         écriture que l'utilisateur n'a pas demandée se dit, et dit où la reprendre. -->
                    <Border Background="{StaticResource Surface2}" CornerRadius="9" Padding="11,9"
                            Margin="0,0,0,4"
                            Visibility="{x:Bind Modele.MessageRattrapage, Mode=OneWay, Converter={StaticResource SiTexte}}">
                        <TextBlock Text="{x:Bind Modele.MessageRattrapage, Mode=OneWay}" FontSize="11.5"
                                   Foreground="{StaticResource Encre3}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind Modele.Projets}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LigneProjet">
                                <Button Style="{StaticResource BoutonNav}" HorizontalAlignment="Stretch"
                                        Padding="12,11" Margin="0,0,0,2"
                                        Command="{Binding DataContext.Modele.OuvrirCommand, ElementName=RacineProjets}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Nom}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="11" Height="11" CornerRadius="4"
                                                VerticalAlignment="Top" Margin="0,4,0,0"
                                                Background="{Binding Couleur, Converter={StaticResource Hex}}" />

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Nom}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Encre}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Un projet fermé le dit ; un projet actif n'a rien à annoncer. -->
                                                <Border Grid.Column="1" Background="{StaticResource Surface2}"
                                                        CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                                        Visibility="{Binding EtiquetteStatut, Converter={StaticResource SiTexte}}">
                                                    <TextBlock Text="{Binding EtiquetteStatut}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Encre3}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Avancement}" FontSize="11.5"
                                                       Foreground="{StaticResource Encre3}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Spacing="6" Margin="2,20,0,0"
                                Visibility="{x:Bind Modele.AucunProjet, Mode=OneWay, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="Aucun projet." FontSize="14" Foreground="{StaticResource Encre2}" />
                        <TextBlock Style="{StaticResource TexteCourant}" FontSize="13"
                                   Text="Un projet est un objectif qu'on poursuit dans le temps. Il porte ses tâches, et son calendrier apparaît automatiquement dans les filtres." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Le projet ouvert et ses tâches ============ -->
        <Border Grid.Column="1" Style="{StaticResource Carte}" Padding="20,18"
                Visibility="{x:Bind Modele.ProjetOuvert, Mode=OneWay, Converter={StaticResource SiObjet}}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Bind Modele.ProjetOuvert.Nom, Mode=OneWay}"
                               Style="{StaticResource TitreVue}" FontSize="21"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <!-- Tout ce qui est affiché se modifie (§5) : un projet se renomme et se
                         recolorie, et son calendrier suit (§5.3, D-030). -->
                    <Button Grid.Column="1" Style="{StaticResource BoutonDiscret}" Content="Renommer"
                            Padding="12,7" FontSize="12.5" VerticalAlignment="Center"
                            Command="{x:Bind Modele.ModifierCommand}" />

                    <!-- Fermer un projet reporte ses tâches à faire (§3.2) : c'est le SERVEUR
                         qui applique la cascade, l'app ne fait que demander. -->
                    <Button Grid.Column="2" Style="{StaticResource BoutonDiscret}" Content="Changer l'état"
                            Padding="12,7" FontSize="12.5" VerticalAlignment="Center"
                            Command="{x:Bind Modele.ChangerStatutCommand}"
                            CommandParameter="{x:Bind Modele.ProjetOuvert, Mode=OneWay}" />

                    <Button Grid.Column="3" Style="{StaticResource BoutonDiscret}" Content="Corbeille"
                            Padding="12,7" FontSize="12.5" VerticalAlignment="Center"
                            Command="{x:Bind Modele.SupprimerProjetCommand}"
                            CommandParameter="{x:Bind Modele.ProjetOuvert, Mode=OneWay}" />
                </Grid>

                <!-- Un seul bloc plutôt que trois rangées : une rangée vide consommerait quand même
                     son RowSpacing, et laisserait un trou sous l'entête tant qu'on ne renomme pas.
                     Les écarts sont donc portés par des marges, qui disparaissent avec l'élément. -->
                <StackPanel Grid.Row="1">

                    <!-- ============ RENOMMER / RECOLORIER (§5.3, D-030) ============
                         Le nom et la couleur d'un projet identifient AUSSI son calendrier : les deux
                         changent ensemble, comme ils sont nés ensemble. -->
                    <StackPanel Spacing="10" Margin="0,0,0,14"
                                Visibility="{x:Bind Modele.EnEdition, Mode=OneWay, Converter={StaticResource SiVrai}}">
                        <TextBox Text="{x:Bind Modele.NomEnCours, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13.5" AutomationProperties.Name="Renommer le projet"
                                 KeyDown="SurToucheRenommer" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- La couleur choisie, en grand : sans elle on tire au sort. -->
                            <Border Width="30" Height="30" CornerRadius="9" BorderThickness="1"
                                    BorderBrush="{StaticResource Trait}"
                                    Background="{x:Bind Modele.CouleurEnCours, Mode=OneWay, Converter={StaticResource Hex}}" />
                            <ItemsRepeater ItemsSource="{x:Bind Modele.Couleurs}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Width="30" Height="30" Padding="0" CornerRadius="9" BorderThickness="1"
                                                BorderBrush="{StaticResource Trait}"
                                                Background="{x:Bind Converter={StaticResource Hex}}"
                                                Command="{Binding DataContext.Modele.ChoisirCouleurCommand, ElementName=RacineProjets}"
                                                CommandParameter="{x:Bind}"
                                                AutomationProperties.Name="Choisir cette couleur" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource BoutonPrimaire}" Content="Enregistrer"
                                    Padding="12,7" FontSize="12.5"
                                    Command="{x:Bind Modele.EnregistrerModificationCommand}" />
                            <Button Style="{StaticResource BoutonDiscret}" Content="Annuler"
                                    Padding="12,7" FontSize="12.5"
                                    Command="{x:Bind Modele.AnnulerModificationCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Les refus se lisent ICI, sous le geste qui les provoque — et non au bas
                         d'une liste de tâches qu'il faut dérouler pour apprendre qu'on a été
                         refusé. -->
                    <TextBlock Text="{x:Bind Modele.Message, Mode=OneWay}" FontSize="12"
                               Foreground="{StaticResource Negatif}" TextWrapping="Wrap"
                               Margin="0,0,0,14"
                               Visibility="{x:Bind Modele.Message, Mode=OneWay, Converter={StaticResource SiTexte}}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind Modele.NouvelleTache, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Ajouter une tâche…" FontSize="13.5"
                                 AutomationProperties.Name="Nouvelle tâche"
                                 KeyDown="SurToucheNouvelleTache" />
                        <Button Grid.Column="1" Style="{StaticResource BoutonDiscret}" Content="Ajouter"
                                Padding="13,8" FontSize="12.5"
                                Command="{x:Bind Modele.AjouterTacheCommand}" />
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="2">
                        <ItemsRepeater ItemsSource="{x:Bind Modele.ProjetOuvert.Taches, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:LigneTache">
                                    <Grid ColumnSpacing="11" Padding="2,7"
                                          BorderBrush="{StaticResource Trait2}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding Faite, Mode=OneWay}" MinWidth="0"
                                                  Padding="0" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Titre}"
                                                  Command="{Binding DataContext.Modele.BasculerTacheCommand, ElementName=RacineProjets}"
                                                  CommandParameter="{Binding}" />

                                        <TextBlock Grid.Column="1" Text="{Binding Titre}" FontSize="13.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Encre}" />

                                        <Button Grid.Column="2" Style="{StaticResource BoutonNav}"
                                                Padding="7,3" VerticalAlignment="Center"
                                                AutomationProperties.Name="Changer la priorité"
                                                Command="{Binding DataContext.Modele.CyclerPrioriteCommand, ElementName=RacineProjets}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{StaticResource Surface2}" CornerRadius="5" Padding="6,1"
                                                    Visibility="{Binding APriorite, Converter={StaticResource SiVrai}}">
                                                <TextBlock Text="{Binding EtiquettePriorite}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Encre3}" />
                                            </Border>
                                        </Button>

                                        <Button Grid.Column="3" Style="{StaticResource BoutonNav}" Content="×"
                                                Padding="8,2" FontSize="15" VerticalAlignment="Center"
                                                Foreground="{StaticResource Encre3}"
                                                AutomationProperties.Name="Mettre la tâche à la corbeille"
                                                Command="{Binding DataContext.Modele.SupprimerTacheCommand, ElementName=RacineProjets}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- ============ CALENDRIER DU PROJET (§5.3, D-028) ============
                             Les mêmes occurrences que le calendrier principal, filtrées sur le seul
                             calendrier de ce projet : « où en est ce projet dans le temps ». -->
                        <Grid Margin="0,22,0,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Modele.MoisCalendrier, Mode=OneWay}" FontSize="15"
                                       FontWeight="SemiBold" CharacterSpacing="-15" VerticalAlignment="Center"
                                       Foreground="{StaticResource Encre}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        HorizontalAlignment="Right">
                                <Button Width="28" Height="28" Padding="0" CornerRadius="8"
                                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Trait}"
                                        BorderThickness="1" Command="{x:Bind Modele.MoisPrecedentCommand}"
                                        AutomationProperties.Name="Mois précédent">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="14" Height="14">
                                            <Path Data="M8.5 3L4.5 7l4 4" Stroke="{StaticResource Encre2}"
                                                  StrokeThickness="1.6" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Width="28" Height="28" Padding="0" CornerRadius="8"
                                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Trait}"
                                        BorderThickness="1" Command="{x:Bind Modele.MoisSuivantCommand}"
                                        AutomationProperties.Name="Mois suivant">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="14" Height="14">
                                            <Path Data="M5.5 3l4 4-4 4" Stroke="{StaticResource Encre2}"
                                                  StrokeThickness="1.6" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource Trait}" BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                                        BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="LUN" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                        <TextBlock Grid.Column="1" Text="MAR" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                        <TextBlock Grid.Column="2" Text="MER" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                        <TextBlock Grid.Column="3" Text="JEU" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                        <TextBlock Grid.Column="4" Text="VEN" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                        <TextBlock Grid.Column="5" Text="SAM" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                        <TextBlock Grid.Column="6" Text="DIM" Style="{StaticResource EtiquetteMajuscule}" Padding="8,7" />
                                    </Grid>
                                </Border>

                                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Modele.Cases}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MaximumRowsOrColumns="7" ItemsStretch="Fill"
                                                           MinItemHeight="64" Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CaseJour">
                                            <Border BorderBrush="{StaticResource Trait2}" BorderThickness="0,0,1,1"
                                                    Padding="5,5,5,6">
                                                <StackPanel Spacing="3">
                                                    <Grid HorizontalAlignment="Left">
                                                        <Border Width="20" Height="20" CornerRadius="10"
                                                                Background="{StaticResource Marque}"
                                                                Visibility="{x:Bind EstAujourdhui, Converter={StaticResource SiVrai}}" />
                                                        <TextBlock Text="{x:Bind Numero}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Width="20" Height="20" Padding="0,2,0,0"
                                                                   HorizontalTextAlignment="Center"
                                                                   Foreground="{x:Bind HorsMois, Converter={StaticResource EncreJour}}" />
                                                        <TextBlock Text="{x:Bind Numero}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Width="20" Height="20" Padding="0,2,0,0"
                                                                   HorizontalTextAlignment="Center" Foreground="White"
                                                                   Visibility="{x:Bind EstAujourdhui, Converter={StaticResource SiVrai}}" />
                                                    </Grid>
                                                    <ItemsRepeater ItemsSource="{x:Bind Pastilles}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:PastilleAgenda">
                                                                <Border CornerRadius="6" Padding="4,2" Margin="0,0,0,2"
                                                                        Background="{x:Bind Type, Converter={StaticResource FondType}}">
                                                                    <TextBlock Text="{x:Bind Titre}" FontSize="10.5"
                                                                               Foreground="{StaticResource Encre}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                    <TextBlock Text="{x:Bind Debordement}" FontSize="10" Padding="4,0"
                                                               Foreground="{StaticResource Encre3}"
                                                               Visibility="{x:Bind Debordement, Converter={StaticResource SiTexte}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource TexteCourant}" FontSize="12.5" Margin="2,10,0,0"
                                   Visibility="{x:Bind Modele.CalendrierGarni, Mode=OneWay, Converter={StaticResource SiFaux}}"
                                   Text="Rien de daté sur ce projet pour l&#x27;instant. Un rendez-vous créé depuis le Calendrier et rangé dans ce calendrier de projet apparaîtra ici." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Rien d'ouvert : on dit quoi faire, sans laisser une moitié d'écran vide et muette. -->
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" MaxWidth="380"
                    Visibility="{x:Bind Modele.ProjetOuvert, Mode=OneWay, Converter={StaticResource SiPasObjet}}">
            <TextBlock Text="Choisis un projet" FontSize="15" Foreground="{StaticResource Encre2}" />
            <TextBlock Style="{StaticResource TexteCourant}" FontSize="13"
                       Text="Ses tâches s'ouvrent ici. Chaque projet a son calendrier, affichable ou masquable depuis l'onglet Calendrier." />
        </StackPanel>
    </Grid>
</UserControl>
