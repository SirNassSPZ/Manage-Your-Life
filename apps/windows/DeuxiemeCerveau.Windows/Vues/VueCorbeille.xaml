<UserControl
    x:Class="DeuxiemeCerveau.Windows.Vues.VueCorbeille"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DeuxiemeCerveau.Windows.Convertisseurs"
    xmlns:vm="using:DeuxiemeCerveau.Presentation.VueModeles">

    <UserControl.Resources>
        <conv:CouleurType x:Key="CouleurType" />
        <conv:BoolVersVisibilite x:Key="SiVrai" />
        <conv:BoolVersVisibiliteInverse x:Key="SiFaux" />
        <conv:TexteVersVisibilite x:Key="SiTexte" />
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource Surface}" Padding="22,20,22,22">
        <StackPanel x:Name="RacineCorbeille" MaxWidth="720" HorizontalAlignment="Left" Spacing="14">

            <TextBlock Text="Corbeille" Style="{StaticResource TitreVue}" />
            <TextBlock Style="{StaticResource TexteCourant}" FontSize="13" MaxWidth="620"
                       HorizontalAlignment="Left"
                       Text="Rien n'est effacé, seulement mis de côté : tout ce qui est ici se restaure d'un geste. La suppression définitive, elle, est la seule destruction réelle de l'application — elle demande une confirmation." />

            <Border Visibility="{x:Bind Modele.Message, Mode=OneWay, Converter={StaticResource SiTexte}}"
                    Background="{StaticResource Surface2}" CornerRadius="10" Padding="14,11">
                <TextBlock Text="{x:Bind Modele.Message, Mode=OneWay}" FontSize="13"
                           Foreground="{StaticResource Encre2}" TextWrapping="Wrap" />
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind Modele.Lignes}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LigneCorbeille">
                        <Border Style="{StaticResource Carte}" Margin="0,0,0,8">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="9" Height="9" CornerRadius="3" VerticalAlignment="Center"
                                            Background="{Binding Type, Converter={StaticResource CouleurType}}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titre}" FontSize="14"
                                                   Foreground="{StaticResource Encre}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding Nature}" FontSize="11.5"
                                                       Foreground="{StaticResource Encre3}" />
                                            <TextBlock Text="·" FontSize="11.5" Foreground="{StaticResource Encre3}" />
                                            <TextBlock Text="{Binding SupprimeLe}" FontSize="11.5"
                                                       Foreground="{StaticResource Encre3}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                Visibility="{Binding ConfirmationPurge, Converter={StaticResource SiFaux}}">
                                        <Button Style="{StaticResource BoutonPrimaire}" Content="Restaurer"
                                                Padding="12,7" FontSize="12.5"
                                                Command="{Binding DataContext.Modele.RestaurerCommand, ElementName=RacineCorbeille}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource BoutonDiscret}" Content="Supprimer définitivement"
                                                Padding="12,7" FontSize="12.5"
                                                Command="{Binding DataContext.Modele.DemanderPurgeCommand, ElementName=RacineCorbeille}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Second temps de la purge. Le libellé dit ce qui va se passer,
                                     pas « êtes-vous sûr » : c'est l'irréversibilité qui doit être lue. -->
                                <Border Visibility="{Binding ConfirmationPurge, Converter={StaticResource SiVrai}}"
                                        Background="{StaticResource NegatifDouce}" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="11">
                                        <TextBlock FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Encre}"
                                                   Text="Cet élément sera détruit sur cet appareil et sur les autres. C'est la seule opération de l'application qui ne se rattrape pas." />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Détruire définitivement" Padding="12,7" FontSize="12.5"
                                                    Foreground="White" BorderThickness="0" CornerRadius="9"
                                                    Background="{StaticResource Negatif}"
                                                    Command="{Binding DataContext.Modele.ConfirmerPurgeCommand, ElementName=RacineCorbeille}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BoutonDiscret}" Content="Annuler"
                                                    Padding="12,7" FontSize="12.5"
                                                    Command="{Binding DataContext.Modele.AnnulerPurgeCommand, ElementName=RacineCorbeille}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel Spacing="6" Margin="2,10,0,0"
                        Visibility="{x:Bind Modele.Vide, Mode=OneWay, Converter={StaticResource SiVrai}}">
                <TextBlock Text="La corbeille est vide." FontSize="14" Foreground="{StaticResource Encre2}" />
                <TextBlock Style="{StaticResource TexteCourant}" FontSize="13" MaxWidth="460"
                           HorizontalAlignment="Left"
                           Text="Ce que tu supprimes ailleurs atterrit ici, et y reste jusqu'à ce que tu décides." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
