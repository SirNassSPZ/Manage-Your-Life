<UserControl
    x:Class="DeuxiemeCerveau.Windows.Vues.VueCalendrier"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pres="using:DeuxiemeCerveau.Windows.Presentation"
    xmlns:vm="using:DeuxiemeCerveau.Windows.VueModeles">

    <UserControl.Resources>
        <pres:CouleurType x:Key="CouleurType" />
        <pres:FondType x:Key="FondType" />
        <pres:EncreJour x:Key="EncreJour" />
        <pres:TexteVersVisibilite x:Key="SiTexte" />
        <pres:BoolVersVisibilite x:Key="SiVrai" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Surface}" Padding="22,20,22,22" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Entête : mois + année, navigation, action principale -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Modele.MoisAffiche, Mode=OneWay}" Style="{StaticResource TitreVue}" />
                <TextBlock Text="{x:Bind Modele.AnneeAffichee, Mode=OneWay}"
                           Style="{StaticResource TitreVueAccessoire}" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Width="30" Height="30" Padding="0" CornerRadius="8"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Trait}"
                        BorderThickness="1" Command="{x:Bind Modele.MoisPrecedentCommand}"
                        AutomationProperties.Name="Mois précédent">
                    <!-- Chevrons dessinés au trait, comme le reste de la coquille : un seul jeu
                         d'icônes et une seule épaisseur (1,6) sur toute la surface. -->
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="14" Height="14">
                            <Path Data="M8.5 3L4.5 7l4 4" Stroke="{StaticResource Encre2}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Width="30" Height="30" Padding="0" CornerRadius="8"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Trait}"
                        BorderThickness="1" Command="{x:Bind Modele.MoisSuivantCommand}"
                        AutomationProperties.Name="Mois suivant">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="14" Height="14">
                            <Path Data="M5.5 3l4 4-4 4" Stroke="{StaticResource Encre2}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource BoutonDiscret}" Content="Aujourd'hui" Padding="11,6"
                        FontSize="12.5" Margin="6,0,0,0"
                        Command="{x:Bind Modele.RevenirAujourdhuiCommand}"
                        Visibility="{x:Bind Modele.HorsMoisCourant, Mode=OneWay, Converter={StaticResource SiVrai}}" />
            </StackPanel>

            <Button Grid.Column="3" Style="{StaticResource BoutonPrimaire}" Content="Nouvel élément"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Grille mensuelle : entête des jours + six semaines pleines -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Trait}" BorderThickness="1"
                CornerRadius="12" Background="{StaticResource Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Les sept en-têtes partagent la même largeur étoile que la grille dessous :
                     c'est ce qui garantit l'alignement colonne par colonne. -->
                <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                        BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                    <Grid x:Name="EnteteJours">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LUN" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                        <TextBlock Grid.Column="1" Text="MAR" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                        <TextBlock Grid.Column="2" Text="MER" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                        <TextBlock Grid.Column="3" Text="JEU" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                        <TextBlock Grid.Column="4" Text="VEN" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                        <TextBlock Grid.Column="5" Text="SAM" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                        <TextBlock Grid.Column="6" Text="DIM" Style="{StaticResource EtiquetteMajuscule}" Padding="10,9" />
                    </Grid>
                </Border>

                <!-- ItemsRepeater et non ItemsControl : lui seul honore x:Bind dans son gabarit. -->
                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Modele.Cases}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MaximumRowsOrColumns="7" ItemsStretch="Fill"
                                           MinItemHeight="92" Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:CaseJour">
                            <Border BorderBrush="{StaticResource Trait2}" BorderThickness="0,0,1,1" Padding="7,7,7,8">
                                <StackPanel Spacing="4">

                                    <!-- Le jour courant : pastille bleue pleine, comme la maquette.
                                         C'est le seul usage du bleu de marque hors des actions. -->
                                    <Grid HorizontalAlignment="Left">
                                        <Border Width="23" Height="23" CornerRadius="12"
                                                Background="{StaticResource Marque}"
                                                Visibility="{x:Bind EstAujourdhui, Converter={StaticResource SiVrai}}" />
                                        <TextBlock Text="{x:Bind Numero}" FontSize="12.5" FontWeight="SemiBold"
                                                   Width="23" Height="23" Padding="0,3,0,0"
                                                   HorizontalTextAlignment="Center"
                                                   Foreground="{x:Bind HorsMois, Converter={StaticResource EncreJour}}" />
                                        <TextBlock Text="{x:Bind Numero}" FontSize="12.5" FontWeight="SemiBold"
                                                   Width="23" Height="23" Padding="0,3,0,0"
                                                   HorizontalTextAlignment="Center" Foreground="White"
                                                   Visibility="{x:Bind EstAujourdhui, Converter={StaticResource SiVrai}}" />
                                    </Grid>

                                    <ItemsRepeater ItemsSource="{x:Bind Pastilles}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PastilleAgenda">
                                                <Border CornerRadius="7" Padding="6,3" Margin="0,0,0,3"
                                                        Background="{x:Bind Type, Converter={StaticResource FondType}}">
                                                    <Grid ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{x:Bind Type, Converter={StaticResource CouleurType}}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Titre}" FontSize="11.5"
                                                                   Foreground="{StaticResource Encre}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Montant}" FontSize="11.5"
                                                                   FontWeight="SemiBold" CharacterSpacing="-10"
                                                                   Foreground="{StaticResource Encre2}" VerticalAlignment="Center"
                                                                   Visibility="{x:Bind Montant, Converter={StaticResource SiTexte}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <TextBlock Text="{x:Bind Debordement}" FontSize="11" Padding="6,0"
                                               Foreground="{StaticResource Encre3}"
                                               Visibility="{x:Bind Debordement, Converter={StaticResource SiTexte}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>
    </Grid>
</UserControl>
