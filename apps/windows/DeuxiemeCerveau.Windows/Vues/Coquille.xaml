<UserControl
    x:Class="DeuxiemeCerveau.Windows.Vues.Coquille"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pres="using:DeuxiemeCerveau.Windows.Convertisseurs"
    xmlns:vm="using:DeuxiemeCerveau.Presentation.VueModeles"
    xmlns:vues="using:DeuxiemeCerveau.Windows.Vues">

    <!--
        Trois contraintes WinUI qui expliquent la forme de ce fichier :
        1. x:Bind exige une racine FrameworkElement ; Window n'en est pas un. Toute la coquille vit
           donc ici, et FenetrePrincipale ne fait plus que l'héberger.
        2. ItemsControl ne prend PAS en charge x:Bind dans son ItemTemplate (contrairement à
           ListView / ItemsRepeater) : les liaisons compilées y restent nulles, en silence.
           Les gabarits d'items utilisent donc {Binding}, tardif mais fiable.
        3. Les convertisseurs d'un x:Bind sont cherchés dans les ressources du UserControl, PAS
           dans celles d'un élément intérieur. Déclarés sur le Grid, la recherche lève
           « Cannot find a resource with the given key », ce qui interrompt Bindings.Initialize()
           et laisse TOUTE la vue non liée — barre de navigation comprise.
    -->
    <UserControl.Resources>
        <pres:FondActif x:Key="FondActif" />
        <pres:EncreActif x:Key="EncreActif" />
        <pres:TraceGeometrie x:Key="Trace" />
        <pres:HexPinceau x:Key="Hex" />
        <pres:EncreFiltre x:Key="EncreFiltre" />
        <pres:OpaciteFiltre x:Key="OpaciteFiltre" />
        <pres:TexteVersVisibilite x:Key="SiTexte" />
        <pres:BoolVersVisibilite x:Key="SiVrai" />
        <pres:BoolInverse x:Key="SiFaux" />

        <!-- BoutonNav vit dans Ressources/Jetons.xaml : plusieurs vues s'en servent. -->
    </UserControl.Resources>

    <Grid x:Name="Racine" Background="{StaticResource Fond}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ BARRE DU HAUT — navigation principale ============ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Trait}" BorderThickness="0,0,0,1"
                Padding="14,9,14,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="8" Background="{StaticResource Encre}">
                        <TextBlock Text="DC" Foreground="{StaticResource Surface}" FontSize="10.5"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Deuxième Cerveau" FontSize="13" FontWeight="SemiBold"
                                   CharacterSpacing="-10" Foreground="{StaticResource Encre}" />
                        <TextBlock Text="Espace personnel" FontSize="10.5" Foreground="{StaticResource Encre3}" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Modele.Principales}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ElementNav">
                            <Button Style="{StaticResource BoutonNav}"
                                    Background="{Binding Actif, Converter={StaticResource FondActif}}"
                                    Foreground="{Binding Actif, Converter={StaticResource EncreActif}}"
                                    Command="{Binding DataContext.NaviguerCommand, ElementName=Racine}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Titre}">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="20" Height="20">
                                            <Path Data="{Binding Trace, Converter={StaticResource Trace}}"
                                                  Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                            <Path Data="{Binding Trace2, Converter={StaticResource Trace}}"
                                                  Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Titre}" FontSize="13.5" VerticalAlignment="Center" />
                                    <!-- Étiquette V2 : la zone est montrée, jamais codée (périmètre verrouillé). -->
                                    <Border Visibility="{Binding EstV2, Converter={StaticResource SiVrai}}"
                                            Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                                            BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="V2" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Encre3}" />
                                    </Border>
                                    <Border Visibility="{Binding Compteur, Converter={StaticResource SiTexte}}"
                                            Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                                            BorderThickness="1" CornerRadius="999" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Compteur}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Encre3}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="2" BorderBrush="{StaticResource Trait}" BorderThickness="1,0,0,0"
                        Padding="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="SOLDE" FontSize="9.5" FontWeight="SemiBold" CharacterSpacing="50"
                                   Foreground="{StaticResource Encre3}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind Modele.SoldeEntete, Mode=OneWay}" FontSize="15.5"
                                   FontWeight="SemiBold" CharacterSpacing="-20"
                                   Foreground="{StaticResource Positif}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ CORPS : barre latérale contextuelle + vue active ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                    BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel Spacing="20">
                    <StackPanel Visibility="{x:Bind Modele.ASousVues, Mode=OneWay, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="{x:Bind Modele.TitreSousVues, Mode=OneWay}"
                                   Style="{StaticResource EtiquetteMajuscule}" Margin="10,0,0,8" />
                        <ItemsControl ItemsSource="{x:Bind Modele.SousVues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SousVue">
                                    <Button Style="{StaticResource BoutonNav}" Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch" Padding="10,8"
                                            Command="{Binding DataContext.ChoisirSousVueCommand, ElementName=Racine}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Titre}"
                                            Background="{Binding Actif, Converter={StaticResource FondActif}}"
                                            Foreground="{Binding Actif, Converter={StaticResource EncreActif}}">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="20" Height="20">
                                                    <Path Data="{Binding Trace, Converter={StaticResource Trace}}"
                                                          Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                                    <Path Data="{Binding Trace2, Converter={StaticResource Trace}}"
                                                          Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Titre}" FontSize="13.5" VerticalAlignment="Center" />
                                            <Border Visibility="{Binding EstV2, Converter={StaticResource SiVrai}}"
                                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Trait}"
                                                    BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="V2" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{StaticResource Encre3}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Catégorie = label = calendrier : une seule notion (§3.3). -->
                    <StackPanel>
                        <TextBlock Text="MES CALENDRIERS" Style="{StaticResource EtiquetteMajuscule}" Margin="10,0,0,8" />
                        <ItemsControl ItemsSource="{x:Bind Modele.Calendriers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FiltreCalendrier">
                                    <!-- Un vrai Button, pas un StackPanel décoré : afficher ou masquer
                                         un calendrier est une action, elle doit être atteignable au
                                         clavier et annoncée comme telle. -->
                                    <Button Style="{StaticResource BoutonNav}" Padding="10,7"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,1"
                                            Command="{Binding DataContext.BasculerCalendrierCommand, ElementName=Racine}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Nom}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="11" Height="11" CornerRadius="4" VerticalAlignment="Center"
                                                    Opacity="{Binding Visible, Converter={StaticResource OpaciteFiltre}}"
                                                    Background="{Binding Couleur, Converter={StaticResource Hex}}" />
                                            <TextBlock Text="{Binding Nom}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{Binding Visible, Converter={StaticResource EncreFiltre}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Compte Entra. La connexion est un geste explicite : sans elle, l'app reste
                         pleinement utilisable hors ligne (filet 1). -->
                    <StackPanel Spacing="6" Margin="10,0,0,0">
                        <TextBlock Text="{x:Bind Modele.EtatSynchro, Mode=OneWay}" FontSize="11.5"
                                   Foreground="{StaticResource Encre3}" TextWrapping="Wrap" />

                        <TextBlock Text="{x:Bind Modele.Compte, Mode=OneWay}" FontSize="11.5"
                                   Foreground="{StaticResource Encre2}" TextWrapping="Wrap"
                                   Visibility="{x:Bind Modele.Compte, Mode=OneWay, Converter={StaticResource SiTexte}}" />

                        <HyperlinkButton Content="Se connecter" Padding="0" FontSize="12"
                                         Command="{x:Bind Modele.ConnecterCommand}"
                                         IsEnabled="{x:Bind Modele.Occupe, Mode=OneWay, Converter={StaticResource SiFaux}}"
                                         Visibility="{x:Bind Modele.PeutSeConnecter, Mode=OneWay, Converter={StaticResource SiVrai}}" />

                        <HyperlinkButton Content="Se déconnecter" Padding="0" FontSize="12"
                                         Command="{x:Bind Modele.DeconnecterCommand}"
                                         IsEnabled="{x:Bind Modele.Occupe, Mode=OneWay, Converter={StaticResource SiFaux}}"
                                         Visibility="{x:Bind Modele.Compte, Mode=OneWay, Converter={StaticResource SiTexte}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- La vue active est posée par le code-behind, d'après Modele.Zone. -->
            <ContentControl Grid.Column="1" x:Name="Hote"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
