<UserControl
    x:Class="DeuxiemeCerveau.Windows.Vues.Coquille"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pres="using:DeuxiemeCerveau.Windows.Convertisseurs"
    xmlns:vm="using:DeuxiemeCerveau.Presentation.VueModeles"
    xmlns:vues="using:DeuxiemeCerveau.Windows.Vues">

    <!--
        Trois contraintes WinUI qui expliquent la forme de ce fichier :
        1. x:Bind exige une racine FrameworkElement ; Window n'en est pas un. Toute la coquille vit
           donc ici, et FenetrePrincipale ne fait plus que l'héberger.
        2. ItemsControl ne prend PAS en charge x:Bind dans son ItemTemplate (contrairement à
           ListView / ItemsRepeater) : les liaisons compilées y restent nulles, en silence.
           Les gabarits d'items utilisent donc {Binding}, tardif mais fiable.
        3. Les convertisseurs d'un x:Bind sont cherchés dans les ressources du UserControl, PAS
           dans celles d'un élément intérieur. Déclarés sur le Grid, la recherche lève
           « Cannot find a resource with the given key », ce qui interrompt Bindings.Initialize()
           et laisse TOUTE la vue non liée — barre de navigation comprise.
    -->
    <UserControl.Resources>
        <pres:FondActif x:Key="FondActif" />
        <pres:EncreActif x:Key="EncreActif" />
        <pres:TraceGeometrie x:Key="Trace" />
        <pres:HexPinceau x:Key="Hex" />
        <pres:EncreFiltre x:Key="EncreFiltre" />
        <pres:OpaciteFiltre x:Key="OpaciteFiltre" />
        <pres:TexteVersVisibilite x:Key="SiTexte" />
        <pres:BoolVersVisibilite x:Key="SiVrai" />
        <pres:BoolInverse x:Key="SiFaux" />
        <pres:NomType x:Key="NomType" />
        <pres:JourDate x:Key="JourDate" />
        <pres:IndexPeriodicite x:Key="IndexPeriodicite" />
        <pres:BoolCoche x:Key="Coche" />

        <!-- BoutonNav vit dans Ressources/Jetons.xaml : plusieurs vues s'en servent. -->
    </UserControl.Resources>

    <Grid x:Name="Racine" Background="{StaticResource Fond}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ BARRE DU HAUT — navigation principale ============ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Trait}" BorderThickness="0,0,0,1"
                Padding="14,9,14,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="8" Background="{StaticResource Encre}">
                        <TextBlock Text="DC" Foreground="{StaticResource Surface}" FontSize="10.5"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Deuxième Cerveau" FontSize="13" FontWeight="SemiBold"
                                   CharacterSpacing="-10" Foreground="{StaticResource Encre}" />
                        <TextBlock Text="Espace personnel" FontSize="10.5" Foreground="{StaticResource Encre3}" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Modele.Principales}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ElementNav">
                            <Button Style="{StaticResource BoutonNav}"
                                    Background="{Binding Actif, Converter={StaticResource FondActif}}"
                                    Foreground="{Binding Actif, Converter={StaticResource EncreActif}}"
                                    Command="{Binding DataContext.NaviguerCommand, ElementName=Racine}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Titre}">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="20" Height="20">
                                            <Path Data="{Binding Trace, Converter={StaticResource Trace}}"
                                                  Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                            <Path Data="{Binding Trace2, Converter={StaticResource Trace}}"
                                                  Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Titre}" FontSize="13.5" VerticalAlignment="Center" />
                                    <!-- Étiquette V2 : la zone est montrée, jamais codée (périmètre verrouillé). -->
                                    <Border Visibility="{Binding EstV2, Converter={StaticResource SiVrai}}"
                                            Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                                            BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="V2" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Encre3}" />
                                    </Border>
                                    <Border Visibility="{Binding Compteur, Converter={StaticResource SiTexte}}"
                                            Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                                            BorderThickness="1" CornerRadius="999" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Compteur}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Encre3}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="2" BorderBrush="{StaticResource Trait}" BorderThickness="1,0,0,0"
                        Padding="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <!-- « POINT DE DÉPART », pas « SOLDE » : ce chiffre est le solde de
                             référence (§3.4), immobile par conception. L'appeler « solde » le
                             faisait passer pour l'argent du moment — c'est le solde COURANT de
                             l'accueil qui joue ce rôle (§5.1), et lui vient du serveur. -->
                        <TextBlock Text="POINT DE DÉPART" FontSize="9.5" FontWeight="SemiBold" CharacterSpacing="50"
                                   Foreground="{StaticResource Encre3}" HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind Modele.SoldeEntete, Mode=OneWay}" FontSize="15.5"
                                   FontWeight="SemiBold" CharacterSpacing="-20"
                                   Foreground="{StaticResource Positif}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ CORPS : barre latérale contextuelle + vue active ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Trait}"
                    BorderThickness="0,0,1,0" Padding="12,16">
                <StackPanel Spacing="20">
                    <StackPanel Visibility="{x:Bind Modele.ASousVues, Mode=OneWay, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="{x:Bind Modele.TitreSousVues, Mode=OneWay}"
                                   Style="{StaticResource EtiquetteMajuscule}" Margin="10,0,0,8" />
                        <ItemsControl ItemsSource="{x:Bind Modele.SousVues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SousVue">
                                    <Button Style="{StaticResource BoutonNav}" Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch" Padding="10,8"
                                            Command="{Binding DataContext.ChoisirSousVueCommand, ElementName=Racine}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Titre}"
                                            Background="{Binding Actif, Converter={StaticResource FondActif}}"
                                            Foreground="{Binding Actif, Converter={StaticResource EncreActif}}">
                                        <StackPanel Orientation="Horizontal" Spacing="11">
                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="20" Height="20">
                                                    <Path Data="{Binding Trace, Converter={StaticResource Trace}}"
                                                          Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                                    <Path Data="{Binding Trace2, Converter={StaticResource Trace}}"
                                                          Stroke="{StaticResource Encre3}" StrokeThickness="1.6" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Titre}" FontSize="13.5" VerticalAlignment="Center" />
                                            <Border Visibility="{Binding EstV2, Converter={StaticResource SiVrai}}"
                                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Trait}"
                                                    BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="V2" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{StaticResource Encre3}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Catégorie = label = calendrier : une seule notion (§3.3). Visible seulement
                         là où ces filtres agissent : ailleurs, ce seraient des cases sans effet. -->
                    <StackPanel Visibility="{x:Bind Modele.AFiltresCalendrier, Mode=OneWay, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="MES CALENDRIERS" Style="{StaticResource EtiquetteMajuscule}" Margin="10,0,0,8" />
                        <ItemsControl ItemsSource="{x:Bind Modele.Calendriers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FiltreCalendrier">
                                    <!-- Un vrai Button, pas un StackPanel décoré : afficher ou masquer
                                         un calendrier est une action, elle doit être atteignable au
                                         clavier et annoncée comme telle. -->
                                    <Button Style="{StaticResource BoutonNav}" Padding="10,7"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,1"
                                            Command="{Binding DataContext.BasculerCalendrierCommand, ElementName=Racine}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Nom}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="11" Height="11" CornerRadius="4" VerticalAlignment="Center"
                                                    Opacity="{Binding Visible, Converter={StaticResource OpaciteFiltre}}"
                                                    Background="{Binding Couleur, Converter={StaticResource Hex}}" />
                                            <TextBlock Text="{Binding Nom}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{Binding Visible, Converter={StaticResource EncreFiltre}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Calendriers de projets (§5.4, V1 depuis D-027). Une section à part : on ne
                         les crée ni ne les supprime à la main, ils naissent et s'éteignent avec
                         leur projet. Les mêler aux autres rendrait « Mes calendriers » ingérable. -->
                    <StackPanel Visibility="{x:Bind Modele.AFiltresProjetsVisibles, Mode=OneWay, Converter={StaticResource SiVrai}}">
                        <TextBlock Text="PROJETS" Style="{StaticResource EtiquetteMajuscule}" Margin="10,0,0,8" />
                        <ItemsControl ItemsSource="{x:Bind Modele.CalendriersProjets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FiltreCalendrier">
                                    <Button Style="{StaticResource BoutonNav}" Padding="10,7"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,1"
                                            Command="{Binding DataContext.BasculerCalendrierCommand, ElementName=Racine}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Nom}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="11" Height="11" CornerRadius="4" VerticalAlignment="Center"
                                                    Opacity="{Binding Visible, Converter={StaticResource OpaciteFiltre}}"
                                                    Background="{Binding Couleur, Converter={StaticResource Hex}}" />
                                            <TextBlock Text="{Binding Nom}" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{Binding Visible, Converter={StaticResource EncreFiltre}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sauvegarde (§5.7). Placée contre l'état de synchro, et non dans un écran à
                         elle : les deux répondent à la même question — « où sont mes données, et
                         qu'est-ce qui les protège ». L'export, lui, n'a jamais besoin du réseau. -->
                    <StackPanel Spacing="4" Margin="10,0,0,0">
                        <TextBlock Text="SAUVEGARDE" Style="{StaticResource EtiquetteMajuscule}"
                                   Margin="0,0,0,4" />

                        <HyperlinkButton Content="Exporter une archive…" Padding="0" FontSize="12"
                                         Command="{x:Bind Modele.Sauvegarde.ExporterCommand}"
                                         IsEnabled="{x:Bind Modele.Sauvegarde.Occupe, Mode=OneWay, Converter={StaticResource SiFaux}}" />

                        <HyperlinkButton Content="Importer une archive…" Padding="0" FontSize="12"
                                         Command="{x:Bind Modele.Sauvegarde.ImporterCommand}"
                                         IsEnabled="{x:Bind Modele.Sauvegarde.Occupe, Mode=OneWay, Converter={StaticResource SiFaux}}" />

                        <!-- §5.7 : le rappel mensuel doit être désactivable. -->
                        <!-- {Binding} et non x:Bind : sur ce chemin imbriqué, la liaison compilée rendait null,
                             et IsChecked (bool?) affichait alors la case en INDÉTERMINÉ. -->
                        <CheckBox IsChecked="{Binding Sauvegarde.RappelMensuel, Mode=TwoWay}"
                                  MinWidth="0" Margin="0,2,0,0" Padding="8,0,0,0"
                                  AutomationProperties.Name="Rappel mensuel d'export">
                            <TextBlock Text="Me le rappeler chaque mois" FontSize="11.5"
                                       Foreground="{StaticResource Encre2}" TextWrapping="Wrap" />
                        </CheckBox>

                        <TextBlock Text="{x:Bind Modele.Sauvegarde.Message, Mode=OneWay}"
                                   FontSize="11.5" Foreground="{StaticResource Encre2}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{x:Bind Modele.Sauvegarde.Message, Mode=OneWay, Converter={StaticResource SiTexte}}" />
                    </StackPanel>

                    <!-- Compte Entra. La connexion est un geste explicite : sans elle, l'app reste
                         pleinement utilisable hors ligne (filet 1). -->
                    <StackPanel Spacing="6" Margin="10,0,0,0">
                        <TextBlock Text="{x:Bind Modele.EtatSynchro, Mode=OneWay}" FontSize="11.5"
                                   Foreground="{StaticResource Encre3}" TextWrapping="Wrap" />

                        <TextBlock Text="{x:Bind Modele.Compte, Mode=OneWay}" FontSize="11.5"
                                   Foreground="{StaticResource Encre2}" TextWrapping="Wrap"
                                   Visibility="{x:Bind Modele.Compte, Mode=OneWay, Converter={StaticResource SiTexte}}" />

                        <HyperlinkButton Content="Se connecter" Padding="0" FontSize="12"
                                         Command="{x:Bind Modele.ConnecterCommand}"
                                         IsEnabled="{x:Bind Modele.Occupe, Mode=OneWay, Converter={StaticResource SiFaux}}"
                                         Visibility="{x:Bind Modele.PeutSeConnecter, Mode=OneWay, Converter={StaticResource SiVrai}}" />

                        <HyperlinkButton Content="Se déconnecter" Padding="0" FontSize="12"
                                         Command="{x:Bind Modele.DeconnecterCommand}"
                                         IsEnabled="{x:Bind Modele.Occupe, Mode=OneWay, Converter={StaticResource SiFaux}}"
                                         Visibility="{x:Bind Modele.Compte, Mode=OneWay, Converter={StaticResource SiTexte}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- La vue active est posée par le code-behind, d'après Modele.Zone. -->
            <ContentControl Grid.Column="1" x:Name="Hote"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- ============ SAISIE TYPÉE (§13) — par-dessus tout l'écran ============
             Un voile plutôt qu'un ContentDialog : la saisie est le geste central de
             l'application, et un dialogue système imposerait ses propres boutons, sa police et
             ses coins. Ici la forme reste celle de la maquette. -->
        <Grid Grid.RowSpan="2" x:Name="VoileSaisie" Background="#66000000"
              Visibility="{x:Bind Modele.Saisie.Ouvert, Mode=OneWay, Converter={StaticResource SiVrai}}">

            <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RayonFenetre}"
                    BorderBrush="{StaticResource Trait}" BorderThickness="1"
                    Padding="24,22" Width="460" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer>
                    <StackPanel Spacing="15">
                        <TextBlock Text="Ajouter" Style="{StaticResource TitreVue}" FontSize="21" />

                        <!-- Le type d'abord : il commande tout le reste du formulaire. -->
                        <StackPanel Spacing="7">
                            <TextBlock Text="TYPE" Style="{StaticResource EtiquetteMajuscule}" />
                            <ItemsControl ItemsSource="{x:Bind Modele.Saisie.Types}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoixType">
                                        <!-- L'état actif se dit SUR le bouton : sans lui, les cinq
                                             types sont indiscernables et on ne sait pas ce qu'on crée. -->
                                        <Button Style="{StaticResource BoutonDiscret}" Padding="12,7" FontSize="12.5"
                                                Content="{Binding Nom}"
                                                Background="{Binding Actif, Converter={StaticResource FondActif}}"
                                                Foreground="{Binding Actif, Converter={StaticResource EncreActif}}"
                                                Command="{Binding DataContext.Saisie.ChoisirTypeCommand, ElementName=Racine}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="TITRE" Style="{StaticResource EtiquetteMajuscule}" />
                            <TextBox Text="{x:Bind Modele.Saisie.Titre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Loyer, salaire, dentiste…" FontSize="14"
                                     AutomationProperties.Name="Titre" />
                        </StackPanel>

                        <StackPanel Spacing="7"
                                    Visibility="{x:Bind Modele.Saisie.DemandeMontant, Mode=OneWay, Converter={StaticResource SiVrai}}">
                            <TextBlock Text="{x:Bind Modele.Saisie.LibelleMontant, Mode=OneWay}"
                                       Style="{StaticResource EtiquetteMajuscule}" />
                            <TextBox Style="{StaticResource ChampMontant}" PlaceholderText="0,00"
                                     Text="{x:Bind Modele.Saisie.Montant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Montant en euros" />
                        </StackPanel>

                        <!-- Une envie n'a pas d'échéance : c'est un souhait, pas une date. -->
                        <StackPanel Spacing="7"
                                    Visibility="{x:Bind Modele.Saisie.DemandeDate, Mode=OneWay, Converter={StaticResource SiVrai}}">
                            <TextBlock Text="DATE" Style="{StaticResource EtiquetteMajuscule}" />
                            <CalendarDatePicker Date="{x:Bind Modele.Saisie.Date, Mode=TwoWay, Converter={StaticResource JourDate}}"
                                                HorizontalAlignment="Stretch" FontSize="13.5"
                                                AutomationProperties.Name="Date" />

                            <TextBlock Text="RÉPÉTITION" Style="{StaticResource EtiquetteMajuscule}" Margin="0,6,0,0" />
                            <ComboBox SelectedIndex="{x:Bind Modele.Saisie.Periodicite, Mode=TwoWay, Converter={StaticResource IndexPeriodicite}}"
                                      HorizontalAlignment="Stretch" FontSize="13.5"
                                      AutomationProperties.Name="Répétition">
                                <ComboBoxItem Content="Une seule fois" />
                                <ComboBoxItem Content="Tous les mois" />
                                <ComboBoxItem Content="Toutes les semaines" />
                                <ComboBoxItem Content="Tous les ans" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="CALENDRIERS" Style="{StaticResource EtiquetteMajuscule}" />
                            <ItemsControl ItemsSource="{x:Bind Modele.Saisie.Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoixCategorie">
                                        <Button Style="{StaticResource BoutonNav}" Padding="9,6"
                                                HorizontalAlignment="Stretch" Margin="0,0,0,1"
                                                Command="{Binding DataContext.Saisie.BasculerCategorieCommand, ElementName=Racine}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Nom}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="11" Height="11" CornerRadius="4" VerticalAlignment="Center"
                                                        Opacity="{Binding Choisie, Converter={StaticResource OpaciteFiltre}}"
                                                        Background="{Binding Couleur, Converter={StaticResource Hex}}" />
                                                <TextBlock Text="{Binding Nom}" FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{Binding Choisie, Converter={StaticResource EncreFiltre}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{x:Bind Modele.Saisie.Erreur, Mode=OneWay}" FontSize="12.5"
                                   Foreground="{StaticResource Negatif}" TextWrapping="Wrap"
                                   Visibility="{x:Bind Modele.Saisie.Erreur, Mode=OneWay, Converter={StaticResource SiTexte}}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                    Margin="0,4,0,0">
                            <Button Style="{StaticResource BoutonDiscret}" Content="Annuler"
                                    Command="{x:Bind Modele.Saisie.FermerCommand}" />
                            <Button Style="{StaticResource BoutonPrimaire}" Content="Enregistrer"
                                    Command="{x:Bind Modele.Saisie.EnregistrerCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
