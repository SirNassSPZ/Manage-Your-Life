<UserControl
    x:Class="DeuxiemeCerveau.Windows.Vues.VueAujourdhui"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pres="using:DeuxiemeCerveau.Windows.Presentation"
    xmlns:vm="using:DeuxiemeCerveau.Windows.VueModeles">

    <UserControl.Resources>
        <pres:CouleurType x:Key="CouleurType" />
        <pres:CouleurMontant x:Key="CouleurMontant" />
        <pres:TexteVersVisibilite x:Key="SiTexte" />
        <pres:BoolVersVisibilite x:Key="SiVrai" />
        <!-- BoutonPrimaire / BoutonDiscret viennent de Ressources/Jetons.xaml : une seule
             définition pour toute l'app, sinon les vues divergent en silence. -->
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource Surface}" Padding="22,20,22,22">
        <StackPanel>

            <!-- Entête : la salutation, puis les deux gestes du jour -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Modele.Salutation, Mode=OneWay}" Style="{StaticResource TitreVue}" />
                    <TextBlock Text="{x:Bind Modele.DateDuJour, Mode=OneWay}"
                               Style="{StaticResource TitreVueAccessoire}" VerticalAlignment="Bottom" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonDiscret}" Content="Recaler le solde" />
                    <Button Style="{StaticResource BoutonPrimaire}" Content="Ajouter" />
                </StackPanel>
            </Grid>

            <!-- Hero éditorial : UN chiffre dominant, des statistiques secondaires discrètes -->
            <Grid Margin="0,2,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SOLDE DE RÉFÉRENCE" Style="{StaticResource EtiquetteMajuscule}" />
                    <TextBlock Text="{x:Bind Modele.SoldeAffiche, Mode=OneWay}"
                               Style="{StaticResource HeroChiffre}" Margin="0,9,0,0" />
                    <TextBlock Text="{x:Bind Modele.SoldeMention, Mode=OneWay}"
                               Style="{StaticResource TexteCourant}" FontSize="13"
                               MaxWidth="440" HorizontalAlignment="Left" Margin="0,13,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="11" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Modele.NombreAujourdhui, Mode=OneWay}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource Encre}" />
                        <TextBlock Text="aujourd'hui" FontSize="12.5" Foreground="{StaticResource Encre3}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind Modele.NombreSeptJours, Mode=OneWay}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource Encre}" />
                        <TextBlock Text="sous 7 jours" FontSize="12.5" Foreground="{StaticResource Encre3}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Le premier mois à découvert (§5.1 point 5). Arrive du serveur en tâche de
                         fond : absent tant qu'il ne répond pas, et absent s'il n'y a rien de rouge. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                Visibility="{x:Bind Modele.AlerteMontant, Mode=OneWay, Converter={StaticResource SiTexte}}">
                        <TextBlock Text="{x:Bind Modele.AlerteMontant, Mode=OneWay}" FontSize="15"
                                   FontWeight="SemiBold" CharacterSpacing="-10"
                                   Foreground="{StaticResource Negatif}" />
                        <TextBlock Text="{x:Bind Modele.AlerteLibelle, Mode=OneWay}" FontSize="12.5"
                                   Foreground="{StaticResource Encre3}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Agenda : les jours sans mouvement sont omis par le service, pas masqués ici -->
            <ItemsControl ItemsSource="{x:Bind Modele.Agenda}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupeAgenda">
                        <StackPanel>
                            <Grid Padding="4,14,4,6">
                                <TextBlock Text="{x:Bind Titre}" Style="{StaticResource EtiquetteMajuscule}" />
                                <TextBlock Text="{x:Bind Resume}" FontSize="11"                                           Foreground="{StaticResource Encre2}" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Lignes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LigneAgenda">
                                        <Border BorderBrush="{StaticResource Trait2}" BorderThickness="0,0,0,1"
                                                CornerRadius="9" Padding="8,9">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Heure}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Encre2}" />
                                                    <TextBlock Text="{x:Bind Mention}" FontSize="10" FontWeight="SemiBold"
                                                               CharacterSpacing="40" Foreground="{StaticResource Encre3}"
                                                               Visibility="{x:Bind Mention, Converter={StaticResource SiTexte}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                                            VerticalAlignment="Center">
                                                    <Border Width="9" Height="9" CornerRadius="3" VerticalAlignment="Center"
                                                            Background="{x:Bind Type, Converter={StaticResource CouleurType}}" />
                                                    <TextBlock Text="{x:Bind Titre}" FontSize="14"
                                                               Foreground="{StaticResource Encre}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{x:Bind Montant}" FontSize="14"
                                                           FontWeight="SemiBold" CharacterSpacing="-10"
                                                           VerticalAlignment="Center"
                                                           Foreground="{x:Bind Sens, Converter={StaticResource CouleurMontant}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Rien à afficher : on le dit, on ne laisse pas une page vide -->
            <StackPanel Visibility="{x:Bind Modele.AgendaVide, Mode=OneWay, Converter={StaticResource SiVrai}}"
                        Margin="4,26,0,0" Spacing="6">
                <TextBlock Text="Rien de prévu sur les sept prochains jours."
                           FontSize="14" Foreground="{StaticResource Encre2}" />
                <TextBlock Text="Ajoute une facture, un revenu ou un rendez-vous : il apparaîtra ici et au calendrier."
                           Style="{StaticResource TexteCourant}" FontSize="13" MaxWidth="440"
                           HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
