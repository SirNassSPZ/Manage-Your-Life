<!--
    Jetons visuels — transcription fidèle de docs/maquette.html.
    Le ton : le calme de Notion, la lisibilité du calendrier d'Apple.
    Le bleu de marque est RÉSERVÉ aux actions et à « aujourd'hui » ; les couleurs
    catégorielles sont terreuses et fonctionnelles, jamais décoratives.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Surfaces et encres ============ -->
    <Color x:Key="CouleurFond">#F6F5F4</Color>
    <Color x:Key="CouleurSurface">#FFFFFF</Color>
    <Color x:Key="CouleurSurface2">#EFEDEA</Color>
    <Color x:Key="CouleurEncre">#1A1917</Color>
    <Color x:Key="CouleurEncre2">#605C58</Color>

    <!--
        Encre3 — écart ASSUMÉ avec la maquette, décidé en faveur de la lisibilité.
        La maquette pose #9A938C, mesuré à 2,6:1 sur Surface2 : sous le seuil WCAG AA de 4,5:1 pour
        du petit texte, or c'est précisément l'encre des libellés en petites capitales (en-têtes de
        jours, « SOLDE DE RÉFÉRENCE », intitulés de section). #6E6862 tient 4,7:1 sur Surface2 et
        5,5:1 sur blanc, en gardant le même ton chaud et les trois niveaux d'encre distincts.
    -->
    <Color x:Key="CouleurEncre3">#6E6862</Color>

    <!-- Estompage VRAI (jours hors du mois affiché) : ni du texte à lire, ni un contrôle. -->
    <Color x:Key="CouleurEncre4">#9A938C</Color>
    <Color x:Key="CouleurTrait">#E7E5E1</Color>
    <Color x:Key="CouleurTrait2">#EFEDEA</Color>

    <SolidColorBrush x:Key="Fond" Color="{StaticResource CouleurFond}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource CouleurSurface}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource CouleurSurface2}" />
    <SolidColorBrush x:Key="Encre" Color="{StaticResource CouleurEncre}" />
    <SolidColorBrush x:Key="Encre2" Color="{StaticResource CouleurEncre2}" />
    <SolidColorBrush x:Key="Encre3" Color="{StaticResource CouleurEncre3}" />
    <SolidColorBrush x:Key="Encre4" Color="{StaticResource CouleurEncre4}" />
    <SolidColorBrush x:Key="Trait" Color="{StaticResource CouleurTrait}" />
    <SolidColorBrush x:Key="Trait2" Color="{StaticResource CouleurTrait2}" />

    <!-- ============ Marque — actions et « aujourd'hui » UNIQUEMENT ============ -->
    <Color x:Key="CouleurMarque">#0075DE</Color>
    <Color x:Key="CouleurMarqueEncre">#005BAB</Color>
    <Color x:Key="CouleurMarqueDouce">#E6F1FB</Color>
    <Color x:Key="CouleurMarqueAnneau">#B3D6F4</Color>

    <SolidColorBrush x:Key="Marque" Color="{StaticResource CouleurMarque}" />
    <SolidColorBrush x:Key="MarqueEncre" Color="{StaticResource CouleurMarqueEncre}" />
    <SolidColorBrush x:Key="MarqueDouce" Color="{StaticResource CouleurMarqueDouce}" />
    <SolidColorBrush x:Key="MarqueAnneau" Color="{StaticResource CouleurMarqueAnneau}" />

    <!-- ============ Palette catégorielle « dustée » ============ -->
    <SolidColorBrush x:Key="Ardoise" Color="#4B7F8A" />
    <SolidColorBrush x:Key="ArdoiseDouce" Color="#E7EEF0" />
    <SolidColorBrush x:Key="Sauge" Color="#4A8C63" />
    <SolidColorBrush x:Key="SaugeDouce" Color="#E8F0EA" />
    <SolidColorBrush x:Key="TerreCuite" Color="#BB5A44" />
    <SolidColorBrush x:Key="TerreCuiteDouce" Color="#F3E7E2" />
    <SolidColorBrush x:Key="Ocre" Color="#A97E3C" />
    <SolidColorBrush x:Key="OcreDouce" Color="#EFE8D9" />
    <SolidColorBrush x:Key="Mauve" Color="#7A6AA6" />
    <SolidColorBrush x:Key="MauveDouce" Color="#E9E7F1" />

    <!-- Sens de l'argent : entrée positive / sortie négative -->
    <SolidColorBrush x:Key="Positif" Color="#4A8C63" />
    <SolidColorBrush x:Key="Negatif" Color="#BB5340" />
    <SolidColorBrush x:Key="NegatifDouce" Color="#F3E5E1" />

    <!-- ============ Rayons ============ -->
    <CornerRadius x:Key="RayonFenetre">16</CornerRadius>
    <CornerRadius x:Key="RayonCarte">12</CornerRadius>
    <CornerRadius x:Key="RayonPilule">7</CornerRadius>
    <CornerRadius x:Key="RayonBouton">9</CornerRadius>

    <!--
        ============ Reprise des jetons de WinUI ============
        Sans ces surcharges, les contrôles d'origine gardent l'accent bleu SYSTÈME de Windows,
        des coins à 4 px et le soulignement de focus des TextBox : trois signatures visuelles
        étrangères à la maquette, qui la contredisent dès qu'un champ apparaît à l'écran.
        Les clés ci-dessous sont celles du thème WinUI ; les redéfinir ici les remplace partout.
    -->
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <!-- L'accent devient LE bleu de la marque : cases à cocher, focus, sélection. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource CouleurMarque}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource CouleurMarqueEncre}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource CouleurMarqueEncre}" />
    <SolidColorBrush x:Key="SystemAccentColorLight2" Color="{StaticResource CouleurMarque}" />

    <!-- Champs de saisie : une carte bordée, pas un champ souligné. -->
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource CouleurSurface}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource CouleurSurface}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource CouleurSurface}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource CouleurTrait}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource CouleurEncre3}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource CouleurMarque}" />

    <!-- ============ Formes partagées ============ -->
    <!-- Une carte : surface blanche, trait fin, rayon 12 — le conteneur de base de la maquette. -->
    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RayonCarte}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!--
        Bouton d'action. Le dégradé très léger reproduit le « inset 0 1px 0 rgba(255,255,255,.18) »
        de la maquette : sans lui le bouton paraît plat et imprimé, pas posé sur la surface.
    -->
    <Style x:Key="BoutonPrimaire" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RayonBouton}" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#1F8AE8" />
                    <GradientStop Offset="1" Color="{StaticResource CouleurMarque}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoutonDiscret" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Encre}" />
        <Setter Property="BorderBrush" Value="{StaticResource Trait}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RayonBouton}" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
    </Style>

    <!-- Champ de montant : aligné à droite, tabulaire de fait, sans spinner. -->
    <Style x:Key="ChampMontant" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ============ Typographie ============ -->
    <!-- L'approche (CharacterSpacing) est en millièmes de cadratin : -25 ≈ -0,025em. -->
    <FontFamily x:Key="PoliceUI">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="TitreVue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{StaticResource Encre}" />
    </Style>

    <Style x:Key="TitreVueAccessoire" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{StaticResource Encre3}" />
    </Style>

    <!-- Le chiffre dominant du hero : un seul par vue. -->
    <Style x:Key="HeroChiffre" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-35" />
        <Setter Property="Foreground" Value="{StaticResource Encre}" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="EtiquetteMajuscule" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{StaticResource Encre3}" />
    </Style>

    <Style x:Key="TexteCourant" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource Encre2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Montants. La maquette demandait des chiffres tabulaires (tnum) ; WinUI 3 n'expose AUCUN
        contrôle des fonctionnalités OpenType sur TextBlock (contrairement à WPF et au CSS).
        L'alignement est donc obtenu par des colonnes à largeur fixe et un alignement à droite.
    -->
    <Style x:Key="Montant" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PoliceUI}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="HorizontalTextAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{StaticResource Encre}" />
    </Style>

</ResourceDictionary>
